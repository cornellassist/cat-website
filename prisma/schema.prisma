// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CommunityHighlights {
  id           Int      @id @default(autoincrement())
  title        String
  longDescrip  String
  shortDescrip String
  date         DateTime
  imageUrl     String
  imageAlt     String?
}

model Sponsor {
  id       Int    @id @default(autoincrement())
  name     String
  imageUrl String
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  descrip   String
  descrip2  String?
  ctaTitle  String?
  ctaLink   String?
  imageUrls String[] @default([])
  imageAlts String[] @default([])
}

model Event {
  id       Int      @id @default(autoincrement())
  title    String
  tags     String[]
  descrip  String
  date     DateTime
  time     String
  location String
  imageUrl String
  archived Boolean
}

model Member {
  id      Int        @id @default(autoincrement())
  name    String
  role    MemberRole
  year    String
  major   String
  college String
}

enum MemberRole {
  TEAM_LEADS
  ENGINEERING_LEADS
  OPERATIONS_LEADS
  OUTREACH_EDU_LEADS
  ENGINEERING
  OUTREACH_EDU
  OPERATIONS
}

model Blog {
  id           Int      @id @default(autoincrement())
  title        String
  excerpt      String
  authorName   String
  authorAvatar String
  publishDate  DateTime
  categories   String[]
  readTime     Int
  image        String
  slug         String
  content      String
}
